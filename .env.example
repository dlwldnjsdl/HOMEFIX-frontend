# =============================================================================
# 로컬 Vite 개발 서버
# =============================================================================
# 선택. 로컬 백엔드 예시입니다. 기본 원격 백엔드에 연결하려면 두 값을 비워 두세요.
API_PROXY_TARGET=http://127.0.0.1:8000
API_PROXY_PATH=/v1

# =============================================================================
# Docker 공통 설정
# =============================================================================
# 호스트 Nginx에서 전달할 FE 경로입니다. 후행 슬래시는 생략할 수 있습니다.
NGINX_ENDPOINT=/test
# VM과 로컬에서 127.0.0.1에 바인딩할 포트입니다.
FE_PORT=8080
# 선택. 컨테이너 기준 API 주소입니다. 비우면 기본 원격 백엔드에 연결합니다.
# 예시 http://host.docker.internal:8000/v1
DOCKER_API_UPSTREAM=

# =============================================================================
# ARM64 운영 배포 설정
# =============================================================================
# 운영에서 변경. VM 호스트 Nginx의 공개 주소를 경로 없이 설정합니다.
# 예시 https://homefix.example.com
# 로컬에서는 비워 두면 http://127.0.0.1:8080을 사용합니다.
PUBLIC_ORIGIN=
# 운영에서 변경. Docker Hub에 푸시한 태그를 설정합니다.
IMAGE_TAG=latest
