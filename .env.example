# =============================================================================
# 로컬 Vite 개발 서버
# =============================================================================
# 선택. 로컬 백엔드 예시입니다. 기본 원격 백엔드에 연결하려면 두 값을 비워 두세요.
API_PROXY_TARGET=http://127.0.0.1:8000
API_PROXY_PATH=/v1

# =============================================================================
# Docker 공통 설정
# =============================================================================
# 컨테이너에서 FE를 제공할 경로입니다. 호스트 Nginx에서 접두사를 제거하면 /로 설정합니다.
NGINX_ENDPOINT=/
# 127.0.0.1에 바인딩할 포트입니다. 비워 두면 배포는 8090, 로컬은 8080을 사용합니다.
FE_PORT=
# 선택. 컨테이너 기준 API 주소입니다. 비우면 기본 원격 백엔드에 연결합니다.
# 예시 http://host.docker.internal:8000/v1
DOCKER_API_UPSTREAM=

# =============================================================================
# ARM64 운영 배포 설정
# =============================================================================
# 시작 스크립트에서 표시할 공개 URL입니다. 공개 경로까지 지정할 수 있습니다.
# 예시 https://homefix.example.com/fixmyhome
# 비워 두면 루프백 주소에 FE_PORT와 NGINX_ENDPOINT를 적용합니다.
PUBLIC_ORIGIN=
# 운영에서 변경. Docker Hub에 푸시한 태그를 설정합니다.
IMAGE_TAG=latest
